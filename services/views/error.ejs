<% layout('layouts/boilerplate') -%>
<% locals.title = locals.title || 'Error' %>
<% locals.ogDescription = 'DevPrint' %>
<% locals.ogImage = '' %>

<div class="card-page-wrap">
<div class="card-page-body">
    <div class="card-hero">
        <div class="card-hero-left">
            <div class="card-hero-eyebrow">Error</div>
        </div>
    </div>

    <div class="dev-card" style="text-align:center; padding: 48px 32px;">
        <div class="error-panel">
            <div class="error-status"><%= status || 500 %></div>
            <h1 class="error-title"><%= title || 'Something went wrong' %></h1>
            <p class="card-bio" style="font-size: 1.1rem; max-width: 680px; margin: 0 auto 20px;"><%= message %></p>
            <div class="error-actions">
                <a href="<%= backUrl || '/' %>" class="btn btn-primary">Back to home</a>
                &nbsp;&nbsp;
                <% if (retryUrl) { %>
                    <a href="<%= retryUrl %>" class="btn btn-ghost">Try again</a>
                <% } %>
            </div>
            
            
        </div>
    </div>
</div>
</div>
