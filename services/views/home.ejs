<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevPrint — Your GitHub, Decoded</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>

<!-- NAV -->
<nav class="nav">
    <a href="/" class="nav-logo">DEV<span>PRINT</span></a>
    <span class="nav-tagline">A developer's mirror</span>
    <div class="nav-actions">
        <a href="/login" class="btn btn-accent">Login with GitHub</a>
    </div>
</nav>

<div class="home-wrap">

    <!-- HERO -->
    <section class="hero">
        
        <h1 class="hero-h1">Your GitHub,</h1>
        <span class="hero-h1-outline">decoded.</span>
        <p class="hero-sub">Log in with GitHub. Your developer card generates instantly — no setup, no typing.</p>
        <div class="hero-cta">
            <a href="/login" class="btn btn-primary">See your card →</a>
            <a href="#features" class="btn btn-ghost">see how it works</a>
        </div>
    </section>

    
    <!-- ══ SEARCH SECTION — CENTERED ══ -->
    <div class="search-section">
        <div class="search-inner">
            <div class="search-section-left">
                <h2 class="search-h1">Find a</h2>
                <span class="search-h1-accent">Developer.</span>
                <p class="search-sub">Enter a GitHub username to generate their developer card.</p>
                <form action="/card" method="GET">
                    <div class="input-field">
                        <span class="input-slash">SEARCH</span>
                        <input name="username" placeholder="github username…" autocomplete="off" />
                        <button type="submit" class="input-submit">GENERATE →</button>
                    </div>
                    <div class="input-hint">press enter or click generate</div>
                    <% if (locals.searchError) { %>
                    <div class="error-box">⚠ User "<%= searchError %>" not found</div>
                    <% } %>
                </form>
            </div>
            <div class="search-section-right">
                <div class="panel-head">Log in to —</div>
                <div class="panel-rule"></div>
                <div class="panel-item">Claim a permanent link at /u/your-username <span class="panel-arrow">→</span></div>
                <div class="panel-item">Regenerate your card on demand <span class="panel-arrow">→</span></div>
                <div class="panel-item">Higher API rate limit via your own GitHub token <span class="panel-arrow">→</span></div>    
            </div>
        </div>
    </div>
    <!-- FEATURE STRIP -->
    <section class="feature-strip" id="features">
        <div class="feature-item">
            <div class="feature-num">01</div>
            <div class="feature-title">GitHub OAuth</div>
            <p class="feature-desc">Sign in with GitHub. Your card loads instantly — no username needed.</p>
        </div>
        <div class="feature-item">
            <div class="feature-num">02</div>
            <div class="feature-title">Live GitHub data</div>
            <p class="feature-desc">Stats, languages, and repos pulled live from the GitHub API.</p>
        </div>
        <div class="feature-item">
            <div class="feature-num">03</div>
            <div class="feature-title">Explore any dev</div>
            <p class="feature-desc">Search any GitHub username and generate their card too.</p>
        </div>
    </section>
    <!-- BOTTOM STRIP -->
<div class="issue-strip">
    <span>DEVPRINT · Decode your github</span>
    <span>Built by <a href="https://github.com/adrish-mage" target="_blank" class="strip-link">@adrish-mage</a> </span>
    <span>© 2026</span>
</div>
</div>

</body>
</html>
